# openai_compatible: any OpenAI-wire-protocol endpoint (vLLM, OpenAI,
# Groq, Together, Ollama, ...). Needs LANGUAGE_MODEL_BASE_URL.
LANGUAGE_MODEL_PROVIDER=openai_compatible
LANGUAGE_MODEL_BASE_URL=http://localhost:8000/v1
LANGUAGE_MODEL_NAME=Qwen/Qwen2.5-14B-Instruct
LANGUAGE_MODEL_API_KEY=not-needed-for-local-vllm
# Optional, openai_compatible only. LANGUAGE_MODEL_SEED pins sampling
# for reproducible runs; LANGUAGE_MODEL_DISABLE_THINKING=true sends
# chat_template_kwargs.enable_thinking=false for hybrid-thinking models
# (e.g. Qwen3) served via vLLM.
# LANGUAGE_MODEL_SEED=0
# LANGUAGE_MODEL_DISABLE_THINKING=true

# google_genai: native Gemini via langchain-google-genai. No base_url
# needed; comment out LANGUAGE_MODEL_BASE_URL above and use:
# LANGUAGE_MODEL_PROVIDER=google_genai
# LANGUAGE_MODEL_NAME=gemini-3.5-flash-lite
# LANGUAGE_MODEL_API_KEY=<your Gemini API key>
# Check https://ai.google.dev/gemini-api/docs/models for current model
# names -- Gemini model names get retired/renamed over time.

VECTOR_STORE_PROVIDER=qdrant
VECTOR_STORE_URL=http://localhost:6333
VECTOR_STORE_COLLECTION_NAME=tender_application_chunks
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
